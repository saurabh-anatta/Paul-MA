<div
  class="promo-bar"
  style="
    --promo-bar-bg: {{ section.settings.background_color }};
    --promo-bar-padding-top: {{ section.settings.padding-block-start }}px;
    --promo-bar-padding-bottom: {{ section.settings.padding-block-end }}px;
    --promo-bar-divider: {{ section.settings.divider_width }}px;
  "
>
  <div class="promo-bar__inner{% if section.settings.section_width == 'page-width' %} page-width{% endif %}">
    {%- if section.settings.show_badge -%}
      <span class="promo-bar__badge">
        {%- if section.settings.badge_image != blank -%}
          <img
            src="{{ section.settings.badge_image | image_url: width: 80 }}"
            alt=""
            width="40"
            height="20"
            loading="lazy"
            class="promo-bar__badge-image"
          >
        {%- endif -%}
        <span class="promo-bar__badge-text">{{ section.settings.badge_text }}</span>
      </span>
    {%- endif -%}
    <span class="promo-bar__text">
      {{ section.settings.promo_text }}
      {%- if section.settings.learn_more_link != blank -%}
        <a href="{{ section.settings.learn_more_link }}" class="promo-bar__link">{{ section.settings.learn_more_text }}</a>
      {%- else -%}
        <span class="promo-bar__link">{{ section.settings.learn_more_text }}</span>
      {%- endif -%}
    </span>
  </div>
</div>

{% stylesheet %}
  .promo-bar {
    background-color: var(--promo-bar-bg, #FFFFFF);
    padding-block-start: var(--promo-bar-padding-top, 10px);
    padding-block-end: var(--promo-bar-padding-bottom, 10px);
    border-bottom: var(--promo-bar-divider, 1px) solid var(--color-border, #E5E5E5);
  }

  .promo-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding-inline: var(--page-margin, 64px);
    flex-wrap: wrap;
  }

  .promo-bar__inner.page-width {
    padding-inline: 0;
  }

  .promo-bar__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(90deg, #C9D855, #69BA86, #408DA1);
    border-radius: 20px;
    padding: 6px 16px;
    flex-shrink: 0;
  }

  .promo-bar__badge-text {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 12px;
    line-height: 16px;
    color: #FFFFFF;
    white-space: nowrap;
  }

  .promo-bar__badge-image {
    width: 40px;
    height: auto;
  }

  .promo-bar__text {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 20px;
    color: #141414;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .promo-bar__link {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 20px;
    color: #207D94;
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  @media screen and (max-width: 749px) {
    .promo-bar__inner {
      padding-inline: 16px;
      gap: 8px;
    }

    .promo-bar__text {
      font-size: 12px;
      line-height: 16px;
      text-align: center;
    }

    .promo-bar__link {
      font-size: 12px;
      line-height: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo bar",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Get Paid Daily"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promo text",
      "default": "$6,073,506,282 awarded in cash!"
    },
    {
      "type": "text",
      "id": "learn_more_text",
      "label": "Learn more text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "learn_more_link",
      "label": "Learn more link"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Bottom border",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
