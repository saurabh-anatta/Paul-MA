{
  "type": "footer",
  "name": "t:names.footer",
  "sections": {
    "footer": {
      "type": "footer",
      "blocks": {
        "left_group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "flex-start",
            "gap": 40,
            "width": "fill",
            "width_mobile": "fill",
            "height": "fit",
            "inherit_color_scheme": true,
            "background_media": "none",
            "border": "none",
            "border_radius": 0,
            "toggle_overlay": false,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "localization": {
              "type": "footer-localization"
            },
            "signup_heading": {
              "type": "text",
              "settings": {
                "text": "<p>Sign up for new product launches, priority access and updates</p>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "h5",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "email_signup": {
              "type": "email-signup",
              "settings": {
                "width": "fill",
                "inherit_color_scheme": true,
                "integrated_button": true,
                "border_style": "all",
                "border_width": 1,
                "border_radius": 40,
                "display_type": "text",
                "style_class": "button",
                "label": "Subscribe",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "disclaimer": {
              "type": "text",
              "settings": {
                "text": "<p>By signing up you agree to our <a href=\"/policies/terms-of-service\">Terms of Use</a> & <a href=\"/policies/privacy-policy\">Privacy Policy</a></p>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "0.75rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "color": "var(--color-foreground)",
                "background": false,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "social_links": {
              "type": "social-links",
              "settings": {
                "facebook_url": "https://www.facebook.com/SHOPCOM",
                "instagram_url": "https://www.instagram.com/shopcom",
                "tiktok_url": "https://www.tiktok.com/@shopcom",
                "twitter_url": "https://www.twitter.com/shopcom",
                "youtube_url": "https://www.youtube.com/shopcom"
              }
            }
          },
          "block_order": [
            "localization",
            "signup_heading",
            "email_signup",
            "disclaimer",
            "social_links"
          ]
        },
        "menu_shop": {
          "type": "menu",
          "settings": {
            "menu": "footer",
            "heading": "Shop",
            "menu_spacing": 8,
            "show_as_accordion": true,
            "accordion_icon": "plus",
            "accordion_dividers": false,
            "inherit_color_scheme": true,
            "heading_preset": "paragraph",
            "link_preset": "paragraph",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "menu_features": {
          "type": "menu",
          "settings": {
            "menu": "main-menu",
            "heading": "Features",
            "menu_spacing": 8,
            "show_as_accordion": true,
            "accordion_icon": "plus",
            "accordion_dividers": false,
            "inherit_color_scheme": true,
            "heading_preset": "paragraph",
            "link_preset": "paragraph",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "menu_learn": {
          "type": "menu",
          "settings": {
            "menu": "footer",
            "heading": "Learn",
            "menu_spacing": 8,
            "show_as_accordion": true,
            "accordion_icon": "plus",
            "accordion_dividers": false,
            "inherit_color_scheme": true,
            "heading_preset": "paragraph",
            "link_preset": "paragraph",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "menu_support": {
          "type": "menu",
          "settings": {
            "menu": "footer",
            "heading": "Support",
            "menu_spacing": 8,
            "show_as_accordion": true,
            "accordion_icon": "plus",
            "accordion_dividers": false,
            "inherit_color_scheme": true,
            "heading_preset": "paragraph",
            "link_preset": "paragraph",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "brand_bar": {
          "type": "_footer-brand-bar"
        }
      },
      "block_order": [
        "left_group",
        "menu_shop",
        "menu_features",
        "menu_learn",
        "menu_support",
        "brand_bar"
      ],
      "settings": {
        "section_width": "page-width",
        "gap": 32,
        "color_scheme": "scheme-4",
        "padding-block-start": 72,
        "padding-block-end": 0
      }
    },
    "utilities": {
      "type": "footer-utilities",
      "settings": {
        "section_width": "page-width",
        "gap": 24,
        "divider_thickness": 1,
        "color_scheme": "scheme-4",
        "padding-block-start": 12,
        "padding-block-end": 16
      },
      "blocks": {
        "copyright": {
          "type": "footer-copyright",
          "settings": {
            "show_powered_by": true,
            "font_size": "0.75rem",
            "case": "none"
          }
        },
        "policy_list": {
          "type": "footer-policy-list",
          "settings": {
            "font_size": "0.75rem",
            "case": "none"
          }
        },
        "social_icons": {
          "type": "social-links",
          "settings": {
            "facebook_url": "https://www.facebook.com",
            "instagram_url": "https://www.instagram.com",
            "tiktok_url": "https://www.tiktok.com",
            "twitter_url": "https://www.twitter.com",
            "youtube_url": "https://www.youtube.com"
          }
        }
      },
      "block_order": [
        "copyright",
        "policy_list",
        "social_icons"
      ]
    }
  },
  "order": [
    "footer",
    "utilities"
  ]
}
