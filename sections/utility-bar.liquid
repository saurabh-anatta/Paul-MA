<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="utility-bar spacing-style section section--full-width color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="utility-bar__inner">
    <div class="utility-bar__text">
      {{ section.settings.left_text }}
    </div>
    {% if section.settings.right_link_label != blank %}
      <a
        class="utility-bar__link"
        {% if section.settings.right_link != blank %}
          href="{{ section.settings.right_link }}"
        {% endif %}
      >
        {{ section.settings.right_link_label }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .utility-bar {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .utility-bar__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-inline: var(--padding-2xl);
  }

  .utility-bar__text {
    color: var(--color-foreground);
  }

  .utility-bar__text a {
    color: var(--color-foreground);
    text-decoration: underline;
  }

  .utility-bar__link {
    color: var(--color-foreground);
    text-decoration: underline;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  @media screen and (max-width: 749px) {
    .utility-bar__link {
      display: none;
    }

    .utility-bar__inner {
      justify-content: center;
      padding-inline: var(--padding-md);
    }

    .utility-bar__text {
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Utility bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "left_text",
      "label": "Left text",
      "default": "Your Shop Consultant is <a href=\"#\">SHOP.COM</a>"
    },
    {
      "type": "text",
      "id": "right_link_label",
      "label": "Right link label",
      "default": "Start Your SHOP.COM Business"
    },
    {
      "type": "url",
      "id": "right_link",
      "label": "Right link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Utility bar"
    }
  ]
}
{% endschema %}
