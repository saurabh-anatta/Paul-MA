{%- liquid
  assign heading = section.settings.heading
  assign background_image = section.settings.background_image
  assign columns = section.settings.columns
  assign columns_gap = section.settings.columns_gap
  assign mobile_columns = section.settings.mobile_columns
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400&display=swap" rel="stylesheet">

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--full-width
    color-{{ section.settings.color_scheme }}
    power-picks-carousel
    spacing-style
  "
  style="
    --carousel-columns: {{ columns }};
    --carousel-gap: {{ columns_gap }}px;
    --carousel-mobile-columns: {{ mobile_columns }};
    {% render 'spacing-style', settings: section.settings %}
  "
  data-testid="power-picks-carousel-section"
>
  {%- if background_image != blank -%}
    {%- assign bg_sizes = '(min-width: 1200px) 1536px, 100vw' -%}
    {{
      background_image
      | image_url: width: background_image.width
      | image_tag:
        sizes: bg_sizes,
        widths: '750,1100,1536,2000',
        loading: 'lazy',
        class: 'power-picks-carousel__background',
        alt: ''
    }}
  {%- endif -%}

  <div class="power-picks-carousel__content">
    {%- if heading != blank -%}
      <div class="power-picks-carousel__header">
        <h2 class="power-picks-carousel__heading">{{ heading }}</h2>
      </div>
    {%- endif -%}

    <div class="power-picks-carousel__track" data-track>
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

<script type="module">
  const section = document.querySelector('[data-testid="power-picks-carousel-section"]');
  if (section) {
    const track = section.querySelector('[data-track]');
    if (track) {
      let isDown = false;
      let startX;
      let scrollLeft;

      track.addEventListener('mousedown', (e) => {
        isDown = true;
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      track.addEventListener('mouseleave', () => { isDown = false; });
      track.addEventListener('mouseup', () => { isDown = false; });

      track.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.5;
        track.scrollLeft = scrollLeft - walk;
      });
    }
  }
</script>

{% stylesheet %}
  .power-picks-carousel {
    position: relative;
    overflow: hidden;
  }

  .power-picks-carousel__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    pointer-events: none;
  }

  .power-picks-carousel__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    max-width: 1408px;
    margin-inline: auto;
    padding-inline: 64px;
  }

  .power-picks-carousel__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-block-end: 32px;
  }

  .power-picks-carousel__heading {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 40px;
    line-height: 48px;
    color: #FFFFFF;
    margin: 0;
  }

  .power-picks-carousel__track {
    display: flex;
    gap: var(--carousel-gap, 32px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .power-picks-carousel__track::-webkit-scrollbar {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .power-picks-carousel__content {
      padding-inline: 16px;
    }

    .power-picks-carousel__heading {
      font-size: 28px;
      line-height: 36px;
    }

    .power-picks-carousel__header {
      margin-block-end: 20px;
    }
  }
{% endstylesheet %}

