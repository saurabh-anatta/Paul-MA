<div class="announcement-badge" {{ block.shopify_attributes }}>
  <div class="announcement-badge__pill">
    {% if block.settings.text != blank %}
      <span class="announcement-badge__text">{{ block.settings.text | escape }}</span>
    {% endif %}
    {% if block.settings.badge_image != blank %}
      {{
        block.settings.badge_image
        | image_url: width: 314
        | image_tag:
          class: 'announcement-badge__image',
          loading: 'lazy',
          alt: block.settings.text
      }}
    {% else %}
      <img
        src="{{ 'frame-1618873215.svg' | asset_url }}"
        alt="VIFT"
        width="157"
        height="20"
        style="width: 157px; height: 20px;"
        loading="lazy"
      >
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .announcement-badge {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .announcement-badge__pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(90deg, #C9D855 0%, #69BA86 50%, #408DA1 100%);
    border-radius: 40px;
    padding: 6px 16px;
    white-space: nowrap;
  }

  .announcement-badge__text {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1rem;
    color: #FFFFFF;
  }

  .announcement-badge__image {
    height: 20px;
    width: auto;
    object-fit: contain;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement badge",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Get Paid Daily"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge image"
    }
  ],
  "presets": [
    {
      "name": "Announcement badge"
    }
  ]
}
{% endschema %}
