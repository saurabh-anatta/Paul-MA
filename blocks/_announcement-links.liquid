{% liquid
  assign menu = block.settings.menu
%}

<div class="announcement-links" {{ block.shopify_attributes }}>
  <button
    class="announcement-links__burger button-unstyled"
    aria-label="Open menu"
    type="button"
    onclick="document.querySelector('#Details-menu-drawer-container summary')?.click()"
  >
    <img
      src="{{ 'menu-streamline-sharp-material-symbols.svg' | asset_url }}"
      alt=""
      width="28"
      height="28"
      style="width: 28px; height: 28px;"
      loading="eager"
    >
  </button>

  {% if menu != blank %}
    <nav class="announcement-links__nav" aria-label="Quick links">
      <ul class="announcement-links__list" role="list">
        {% for link in menu.links limit: 4 %}
          <li class="announcement-links__item">
            <a href="{{ link.url }}" class="announcement-links__link">
              {{ link.title | escape }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}
</div>

{% stylesheet %}
  .announcement-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-shrink: 0;
  }

  .announcement-links__burger {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    color: var(--color-foreground);
    background: none;
    border: none;
  }

  .announcement-links__nav {
    display: flex;
    align-items: center;
  }

  .announcement-links__list {
    display: flex;
    align-items: center;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .announcement-links__link {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.25;
    color: var(--color-foreground);
    text-decoration: none;
    white-space: nowrap;
  }

  .announcement-links__link:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement links",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Announcement links"
    }
  ]
}
{% endschema %}
