<div class="footer-localization" {{ block.shopify_attributes }}>
  <div class="footer-localization__pill">
    <span class="footer-localization__pill-text">
      {{ localization.language.endonym_name | default: 'English' }}
    </span>
    <span class="footer-localization__pill-chevron">
      <img
        src="{{ 'chevron-forward-streamline-outlined-material-symbols.svg' | asset_url }}"
        alt=""
        width="20"
        height="20"
        loading="lazy"
      >
    </span>
  </div>
  <div class="footer-localization__pill">
    <span class="footer-localization__pill-flag">
      <img
        src="{{ 'us-united-states-streamline-flagpack.svg' | asset_url }}"
        alt=""
        width="18"
        height="18"
        loading="lazy"
      >
    </span>
    <span class="footer-localization__pill-text">
      {{ localization.country.name | default: 'United States' }}
    </span>
    <span class="footer-localization__pill-chevron">
      <img
        src="{{ 'chevron-forward-streamline-outlined-material-symbols.svg' | asset_url }}"
        alt=""
        width="20"
        height="20"
        loading="lazy"
      >
    </span>
  </div>
</div>

{% stylesheet %}
  .footer-localization {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-localization__pill {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 8px 4px 12px;
    background-color: #EEEEEE;
    border-radius: 20px;
    cursor: pointer;
  }

  .footer-localization__pill-text {
    font-size: 12px;
    line-height: 16px;
    color: #141414;
    font-family: var(--font-body--family);
    font-weight: 400;
    white-space: nowrap;
  }

  .footer-localization__pill-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .footer-localization__pill-chevron img {
    width: 20px;
    height: 20px;
    transform: rotate(90deg);
  }

  .footer-localization__pill-flag {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .footer-localization__pill-flag img {
    width: 18px;
    height: 18px;
    border-radius: 50%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer localization",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Footer localization",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
