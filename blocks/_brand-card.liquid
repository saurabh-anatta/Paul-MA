<div class="brand-card" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .brand-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-radius: 4px;
    overflow: hidden;
    flex: 0 0 auto;
    scroll-snap-align: start;
    width: calc(
      (100% - (var(--carousel-gap, 16px) * (var(--carousel-columns, 6) - 1))) /
        var(--carousel-columns, 6)
    );
  }

  @media screen and (max-width: 749px) {
    .brand-card {
      gap: 8px;
      width: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand card",
  "tag": null,
  "blocks": [
    {
      "type": "_brand-image"
    },
    {
      "type": "_brand-title"
    },
    {
      "type": "_brand-description"
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Brand card"
    }
  ]
}
{% endschema %}
