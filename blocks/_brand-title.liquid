<h3 class="brand-title" {{ block.shopify_attributes }}>
  {{- block.settings.title -}}
</h3>

{% stylesheet %}
  .brand-title {
    font-family: var(--font-subheading--family);
    font-size: 18px;
    line-height: 29px;
    font-weight: 600;
    text-align: center;
    color: #141414;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand title",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Brand"
    }
  ]
}
{% endschema %}
